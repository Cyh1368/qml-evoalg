# Append to ~/.ssh/config so one Duo login is reused for all later commands.
# After adding this, run a single interactive login to complete Duo MFA:
#     ssh bouchet
# Leave that session open (or use ControlPersist below). Subsequent ssh/scp/
# rsync to "bouchet" reuse the multiplexed socket with NO further MFA.

Host bouchet
    HostName bouchet.ycrc.yale.edu
    User ch2499
    IdentityFile ~/.ssh/bouchet_ch2499
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 8h
    ServerAliveInterval 60
