# Ignore env files anywhere in the project
**/.env
**/.env:Zone.Identifier

# Ignore typical python/node clutter if you have them
**/__pycache__/
**/node_modules/
**/.venv/
**/env/
**/.ipynb_checkpoints/

# pip's HTTP download cache — rebuildable, ~260 MB
**/.pip-cache/

# Monitor polling output; evolution_run.log is kept as a run record
**/monitor.log
**/monitor_resume.log

# Loose scratch logs at the tic-tac-toe root
/tic-tac-toe/*.log

# WSL alternate-data-stream turds
*:Zone.Identifier

# SQLite sidecars (databases are committed after wal_checkpoint)
*.sqlite-wal
*.sqlite-shm

# Build-time-only venv for viz circuit rendering (see viz/README.md)
/viz/.venv_render/

.DS_Store
