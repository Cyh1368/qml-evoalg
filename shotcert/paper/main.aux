\@writefile{toc}{\contentsline {subsection}{\numberline {4.5}Retraction: the switching optimum was an impossible circuit count}{5}{subsection.4.5}\protected@file@percent }
\newlabel{sec:switchretract}{{4.5}{5}{Retraction: the switching optimum was an impossible circuit count}{subsection.4.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces A2.3, the retracted switching result. With circuits correctly bounded by $|G|=2$, a per-circuit price is flat for every $k\ge 2$ and never produces an interior optimum; the previously reported $k=2$ optimum came from charging eight circuits. An interior optimum appears only under a per-switch price on an interleaved schedule.}}{5}{table.5}\protected@file@percent }
\newlabel{tab:switch}{{5}{5}{A2.3, the retracted switching result. With circuits correctly bounded by $|G|=2$, a per-circuit price is flat for every $k\ge 2$ and never produces an interior optimum; the previously reported $k=2$ optimum came from charging eight circuits. An interior optimum appears only under a per-switch price on an interleaved schedule}{table.5}{}}
