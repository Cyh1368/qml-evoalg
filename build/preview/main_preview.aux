\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces WP-REPAIR-2 floor accounting on the orbit-completed distribution (exact finite-orbit floor, uniform weights over the $12$ group images), with the measured predictor invariance $\mathbb  {E}[(f-\mathcal  {T}_Gf)^2]$ and the mean channel residual. The repaired arm is exactly invariant (residual and asymmetry at roundoff, as proved in Appendix~\ref {app:crz}); the asymmetric arms sit below the floor at $\eta {=}1$ by fitting the breaking component.}}{10}{table.5}\protected@file@percent }
\newlabel{tab:rep2floors}{{5}{10}{WP-REPAIR-2 floor accounting on the orbit-completed distribution (exact finite-orbit floor, uniform weights over the $12$ group images), with the measured predictor invariance $\mathbb {E}[(f-\Tg f)^2]$ and the mean channel residual. The repaired arm is exactly invariant (residual and asymmetry at roundoff, as proved in Appendix~\ref {app:crz}); the asymmetric arms sit below the floor at $\eta {=}1$ by fitting the breaking component}{table.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces E-S3 (primary) and E-S1 (the endpoint the first analysis omitted). E-S1 is coverage-conditional: on \texttt  {ring\_n6} the repair never fired, so there is no E-S1 estimate there at all --- an absence the first version did not report.}}{10}{table.6}\protected@file@percent }
\newlabel{tab:search}{{6}{10}{E-S3 (primary) and E-S1 (the endpoint the first analysis omitted). E-S1 is coverage-conditional: on \texttt {ring\_n6} the repair never fired, so there is no E-S1 estimate there at all --- an absence the first version did not report}{table.6}{}}
