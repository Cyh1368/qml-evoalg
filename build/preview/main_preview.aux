\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces The first version's repair record, recomputed with correct replication units. At $\eta {=}0$ the $24$ rows are $8$ units (the target is direction-free); the interval barely excludes $0$ and neither $p$-value is small, so the claim ``enforcing equivariance causally improves risk at $\eta {=}0$'' is \emph  {not} supported by this record. At $\eta {>}0$ the units are (direction, seed) and the cost of enforced invariance is robust.}}{8}{table.2}\protected@file@percent }
\newlabel{tab:v1}{{2}{8}{The first version's repair record, recomputed with correct replication units. At $\eta {=}0$ the $24$ rows are $8$ units (the target is direction-free); the interval barely excludes $0$ and neither $p$-value is small, so the claim ``enforcing equivariance causally improves risk at $\eta {=}0$'' is \emph {not} supported by this record. At $\eta {>}0$ the units are (direction, seed) and the cost of enforced invariance is robust}{table.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Floor accounting on the same record, with per-unit floors instead of one quoted number (the "floor" column is the mean over the $8$/$24$ units; the repaired arm's per-unit excess ranges $[-0.0098,+0.0524]$ at $\eta {=}1$). The floor constrains \emph  {invariant} predictors only, so the asymmetric arms sit \emph  {below} it by fitting the breaking component; the repaired arm sits $+0.023$ above it (mean over units), which is why ``pinned near the floor'' is replaced by a number.}}{8}{table.3}\protected@file@percent }
\newlabel{tab:floors}{{3}{8}{Floor accounting on the same record, with per-unit floors instead of one quoted number (the "floor" column is the mean over the $8$/$24$ units; the repaired arm's per-unit excess ranges $[-0.0098,+0.0524]$ at $\eta {=}1$). The floor constrains \emph {invariant} predictors only, so the asymmetric arms sit \emph {below} it by fitting the breaking component; the repaired arm sits $+0.023$ above it (mean over units), which is why ``pinned near the floor'' is replaced by a number}{table.3}{}}
\@writefile{toc}{\contentsline {paragraph}{What WP-REPAIR-2 decides.}{8}{section*.11}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces WP-REPAIR-2 with the unit definition enforced by design: $\eta {=}0$ is emitted once (the target is direction-free) with $24$ optimiser seeds, $\eta {>}0$ has $8$ directions $\times $ $24$ seeds $=192$ units. Holm is applied within the $\eta {=}0$ and $\eta {=}1$ families. Reading: the repaired arm does beat the \texttt  {original} and the random-direction control at $\eta {=}0$, but the \emph  {gate-count-matched duplicate} control closes most of that gap, so the symmetry-specific part ($-0.0006$) is not established. At $\eta {>}0$ the cost of enforced invariance is robust and grows with the optimiser budget.}}{9}{table.4}\protected@file@percent }
\newlabel{tab:rep2}{{4}{9}{WP-REPAIR-2 with the unit definition enforced by design: $\eta {=}0$ is emitted once (the target is direction-free) with $24$ optimiser seeds, $\eta {>}0$ has $8$ directions $\times $ $24$ seeds $=192$ units. Holm is applied within the $\eta {=}0$ and $\eta {=}1$ families. Reading: the repaired arm does beat the \texttt {original} and the random-direction control at $\eta {=}0$, but the \emph {gate-count-matched duplicate} control closes most of that gap, so the symmetry-specific part ($-0.0006$) is not established. At $\eta {>}0$ the cost of enforced invariance is robust and grows with the optimiser budget}{table.4}{}}
