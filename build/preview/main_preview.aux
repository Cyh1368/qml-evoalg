\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Floor accounting on the same record, with per-unit floors instead of one quoted number (the "floor" column is the mean over the $8$/$24$ units; the repaired arm's per-unit excess ranges $[-0.0098,+0.0524]$ at $\eta {=}1$). The floor constrains \emph  {invariant} predictors only, so the asymmetric arms sit \emph  {below} it by fitting the breaking component; the repaired arm sits $+0.023$ above it (mean over units), which is why ``pinned near the floor'' is replaced by a number.}}{9}{table.3}\protected@file@percent }
\newlabel{tab:floors}{{3}{9}{Floor accounting on the same record, with per-unit floors instead of one quoted number (the "floor" column is the mean over the $8$/$24$ units; the repaired arm's per-unit excess ranges $[-0.0098,+0.0524]$ at $\eta {=}1$). The floor constrains \emph {invariant} predictors only, so the asymmetric arms sit \emph {below} it by fitting the breaking component; the repaired arm sits $+0.023$ above it (mean over units), which is why ``pinned near the floor'' is replaced by a number}{table.3}{}}
