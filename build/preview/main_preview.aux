\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Corrected vs defective gate on identical frozen ring candidates ($60$). $\Delta $ is risk after $-$ risk before (negative helps); ``realised'' counts a non-firing candidate as $0$; costs are measured seconds per candidate. On \texttt  {graphs\_n6} the mismatched and approximate regimes do not exist (no mismatched group exists), and in the valid regimes every gate fires on every candidate, so no rule differs there.}}{16}{table.11}\protected@file@percent }
\newlabel{tab:corrected}{{11}{16}{Corrected vs defective gate on identical frozen ring candidates ($60$). $\Delta $ is risk after $-$ risk before (negative helps); ``realised'' counts a non-firing candidate as $0$; costs are measured seconds per candidate. On \texttt {graphs\_n6} the mismatched and approximate regimes do not exist (no mismatched group exists), and in the valid regimes every gate fires on every candidate, so no rule differs there}{table.11}{}}
\@writefile{toc}{\contentsline {paragraph}{A development-only baseline advantage does not transfer.}{16}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.9}The corrected gate is the comparator that matters (A6)}{16}{subsection.7.9}\protected@file@percent }
\newlabel{sec:corrected}{{7.9}{16}{The corrected gate is the comparator that matters (A6)}{subsection.7.9}{}}
\@writefile{toc}{\contentsline {paragraph}{(1) The recall bottleneck on the valid group was the bug, not the gate.}{16}{section*.19}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(2) The gate does have a safety role, and now we have measured it.}{17}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(3) A strict label gate forfeits benefit under approximate symmetry, and the tolerance \emph  {is} the policy.}{17}{section*.21}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{(4) The defect rule is neither cheap nor much better than random.}{17}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{A structural point about gate metrics.}{17}{section*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {7.10}What a label-preservation verifier can decide (A5.2, A5.3)}{17}{subsection.7.10}\protected@file@percent }
\newlabel{sec:semantics}{{7.10}{17}{What a label-preservation verifier can decide (A5.2, A5.3)}{subsection.7.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Measured label-symmetry groups. $|L_t|/|S_n|$ is the fraction of \emph  {individual uniformly drawn permutations} that the target's labels preserve, under an exact membership test and a known true $L_t$. It is \emph  {not} the acceptance probability of a search proposal, which is a generator list whose closure is sampled non-uniformly; that quantity is $\Pr _{H\sim Q}[H \le L_t]$ and is estimated separately (Table~\ref {tab:accept}). $|L_t|/|S_n| = 1$ still entails vacuity for \emph  {any} proposal distribution supported on permutations of this domain, which is the only claim this table carries.}}{18}{table.12}\protected@file@percent }
\newlabel{tab:semantics}{{12}{18}{Measured label-symmetry groups. $|L_t|/|S_n|$ is the fraction of \emph {individual uniformly drawn permutations} that the target's labels preserve, under an exact membership test and a known true $L_t$. It is \emph {not} the acceptance probability of a search proposal, which is a generator list whose closure is sampled non-uniformly; that quantity is $\Pr _{H\sim Q}[H \le L_t]$ and is estimated separately (Table~\ref {tab:accept}). $|L_t|/|S_n| = 1$ still entails vacuity for \emph {any} proposal distribution supported on permutations of this domain, which is the only claim this table carries}{table.12}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Acceptance probability of the proposal distribution that matters, $\Pr _{H\sim Q}[H \le L_t]$, by $400$ independent Monte-Carlo draws per cell (Wilson intervals are defensible here because the draws are independent by construction, which the fixed panel was not). The ``uniform model'' column is $\Pr $ under the idealised $Q$ the text describes: $|L_t|/|S_n|$ for one uniform permutation and $(|L_t|/|S_n|)^k$ for $k$ independent ones. The empirical row draws the generator lists actually proposed by the model in the frozen search runs ($819$ hypotheses). At $n=9$ the $362880$ permutations are never enumerated: the estimate is probe-based, and the algebraic anchor (the eight square symmetries, all sound on the probe) gives $|L|/|S_9| = 2.2\times 10^{-5}$.}}{18}{table.13}\protected@file@percent }
\newlabel{tab:accept}{{13}{18}{Acceptance probability of the proposal distribution that matters, $\Pr _{H\sim Q}[H \le L_t]$, by $400$ independent Monte-Carlo draws per cell (Wilson intervals are defensible here because the draws are independent by construction, which the fixed panel was not). The ``uniform model'' column is $\Pr $ under the idealised $Q$ the text describes: $|L_t|/|S_n|$ for one uniform permutation and $(|L_t|/|S_n|)^k$ for $k$ independent ones. The empirical row draws the generator lists actually proposed by the model in the frozen search runs ($819$ hypotheses). At $n=9$ the $362880$ permutations are never enumerated: the estimate is probe-based, and the algebraic anchor (the eight square symmetries, all sound on the probe) gives $|L|/|S_9| = 2.2\times 10^{-5}$}{table.13}{}}
\@writefile{toc}{\contentsline {paragraph}{The uniform models are right and irrelevant.}{18}{section*.24}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {14}{\ignorespaces Fixed-panel selectivity (A5.3, units corrected by A6.6): identical ring inputs, only the target varies. The panel is \emph  {nine generator sets}, fixed in advance (identity, rotation, reflection, the declared dihedral group, its $C_3$ and $C_2$ subgroups, the full symmetric group, $20$ random permutations as one joint generator list, and $15$ single transpositions as one joint generator list). These are \emph  {not} independent draws from a population of transformations, so no interval is attached: counts are descriptive coverage, and the distinct-subgroup column is given next to the entry count because the last three entries all generate $S_6$ (seven distinct subgroups among nine entries; the full listing is in \texttt  {research/search/corrected\_gate.json}).}}{19}{table.14}\protected@file@percent }
\newlabel{tab:panel}{{14}{19}{Fixed-panel selectivity (A5.3, units corrected by A6.6): identical ring inputs, only the target varies. The panel is \emph {nine generator sets}, fixed in advance (identity, rotation, reflection, the declared dihedral group, its $C_3$ and $C_2$ subgroups, the full symmetric group, $20$ random permutations as one joint generator list, and $15$ single transpositions as one joint generator list). These are \emph {not} independent draws from a population of transformations, so no interval is attached: counts are descriptive coverage, and the distinct-subgroup column is given next to the entry count because the last three entries all generate $S_6$ (seven distinct subgroups among nine entries; the full listing is in \texttt {research/search/corrected\_gate.json})}{table.14}{}}
